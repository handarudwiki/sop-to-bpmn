// =============================================================================
// BPM / BPMN Workflow Engine - Prisma Schema
// =============================================================================
// This schema models the core entities of a BPMN-based workflow engine:
//   - WorkflowTemplate: The "blueprint" parsed from a BPMN XML file.
//   - WorkflowNode: A single BPMN element (StartEvent, UserTask, Gateway, EndEvent).
//   - SequenceFlow: The directed edges connecting nodes (with optional conditions).
//   - FormSchema: The dynamic form definition attached to a UserTask node.
//   - FormField: Individual fields within a FormSchema.
//   - WorkflowInstance: A running execution of a WorkflowTemplate.
//   - TaskInstance: The state of a specific node within a running instance.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// TEMPLATE LAYER — defines the blueprint of a workflow
// ---------------------------------------------------------------------------

/// A workflow template, generated by parsing a BPMN 2.0 XML file.
/// One template maps to one BPMN process element.
model WorkflowTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  /// Raw BPMN 2.0 XML string as uploaded or AI-generated.
  bpmnXml     String   @db.Text
  /// Slug used to identify the template in URLs.
  slug        String   @unique
  /// Whether this template is ready to have instances started against it.
  isDeployed  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// BPMN elements parsed from the XML.
  nodes         WorkflowNode[]
  /// Directed edges parsed from the XML.
  sequenceFlows SequenceFlow[]
  /// Active and historical instances of this template.
  instances     WorkflowInstance[]
}

/// The type of a BPMN 2.0 element.
enum NodeType {
  START_EVENT
  END_EVENT
  USER_TASK
  SERVICE_TASK
  EXCLUSIVE_GATEWAY  // XOR — only one outgoing flow is taken
  PARALLEL_GATEWAY   // AND — all outgoing flows are taken simultaneously
  INTERMEDIATE_EVENT
}

/// A single BPMN element node within a WorkflowTemplate.
/// Corresponds to one <startEvent>, <userTask>, <exclusiveGateway>, etc. in the XML.
model WorkflowNode {
  id         String   @id @default(cuid())
  /// The BPMN element id attribute (e.g. "Task_1abc").
  bpmnId     String
  name       String
  type       NodeType
  /// Optional human-readable description / documentation from the BPMN XML.
  documentation String?
  /// Ordering hint so the UI can render nodes in sequence.
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  workflowTemplateId String
  workflowTemplate   WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)

  /// Dynamic form definition attached to a UserTask.
  formSchema FormSchema?

  /// Sequence flows that originate from this node.
  outgoingFlows SequenceFlow[] @relation("SourceNode")
  /// Sequence flows that terminate at this node.
  incomingFlows SequenceFlow[] @relation("TargetNode")

  /// Task instances created when a workflow instance reaches this node.
  taskInstances TaskInstance[]

  @@unique([workflowTemplateId, bpmnId])
  @@index([workflowTemplateId])
}

/// A directed edge in the BPMN process flow.
/// Maps to a <sequenceFlow> XML element.
model SequenceFlow {
  id     String @id @default(cuid())
  /// The BPMN element id attribute.
  bpmnId String
  /// Human-readable label (e.g. "Approved", "Rejected").
  name   String?
  /// For exclusive gateways: the condition expression (e.g. "${approved == true}").
  conditionExpression String?
  /// Simplified condition key used by the engine (e.g. "approved").
  conditionKey   String?
  /// The value that conditionKey must equal for this flow to be taken.
  conditionValue String?

  workflowTemplateId String
  workflowTemplate   WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)

  sourceNodeId String
  sourceNode   WorkflowNode @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)

  targetNodeId String
  targetNode   WorkflowNode @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@index([workflowTemplateId])
  @@index([sourceNodeId])
}

// ---------------------------------------------------------------------------
// FORM LAYER — dynamic forms attached to UserTask nodes
// ---------------------------------------------------------------------------

/// A dynamic form definition attached to a WorkflowNode of type USER_TASK.
model FormSchema {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workflowNodeId String       @unique
  workflowNode   WorkflowNode @relation(fields: [workflowNodeId], references: [id], onDelete: Cascade)

  fields FormField[]
}

/// The type of a form input field.
enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  CHECKBOX
  RADIO
  FILE
  APPROVAL /// Special type: renders Approve/Reject buttons.
}

/// A single field within a FormSchema.
model FormField {
  id           String    @id @default(cuid())
  /// Machine-readable key used in form submissions.
  fieldKey     String
  label        String
  type         FieldType
  /// Whether the field must be filled before submission.
  isRequired   Boolean   @default(false)
  /// Default value for the field.
  defaultValue String?
  /// JSON-encoded options list for SELECT/RADIO fields (e.g. ["Option A","Option B"]).
  options      String?   @db.Text
  /// Display order within the form.
  position     Int       @default(0)
  placeholder  String?
  helpText     String?

  formSchemaId String
  formSchema   FormSchema @relation(fields: [formSchemaId], references: [id], onDelete: Cascade)

  @@index([formSchemaId])
}

// ---------------------------------------------------------------------------
// INSTANCE LAYER — running executions of a workflow
// ---------------------------------------------------------------------------

/// The status of a workflow instance or task.
enum InstanceStatus {
  PENDING     /// Not yet started.
  IN_PROGRESS /// Currently active.
  COMPLETED   /// Finished successfully.
  REJECTED    /// Rejected by a user (terminal state for approval tasks).
  CANCELLED   /// Administratively cancelled.
  ERROR       /// An error occurred during processing.
}

/// A running (or completed) execution of a WorkflowTemplate.
/// Each time a user clicks "Start New Instance", one WorkflowInstance is created.
model WorkflowInstance {
  id        String         @id @default(cuid())
  title     String
  status    InstanceStatus @default(PENDING)
  /// The BPMN element id of the node the engine is currently at.
  currentNodeBpmnId String?
  /// JSON blob of business data collected across all task submissions.
  contextData String? @db.Text
  startedAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  completedAt DateTime?

  /// Who initiated this instance (simple string, no auth required).
  initiatedBy String?

  workflowTemplateId String
  workflowTemplate   WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id])

  /// Individual task records, one per node visited.
  taskInstances TaskInstance[]

  @@index([workflowTemplateId])
  @@index([status])
}

/// A record of one node-visit within a WorkflowInstance.
/// When the engine routes to a USER_TASK node, a TaskInstance is created and
/// displayed as a to-do item in the user's inbox.
model TaskInstance {
  id        String         @id @default(cuid())
  status    InstanceStatus @default(PENDING)
  /// JSON blob of data submitted by the user when completing this task.
  formData  String?        @db.Text
  /// The decision made at an approval gateway (e.g. "approved", "rejected").
  decision  String?
  /// Notes/comments left by the user when completing this task.
  comments  String?        @db.Text
  assignedTo  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  completedAt DateTime?

  workflowInstanceId String
  workflowInstance   WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)

  workflowNodeId String
  workflowNode   WorkflowNode @relation(fields: [workflowNodeId], references: [id])

  @@index([workflowInstanceId])
  @@index([status])
  @@index([assignedTo])
}
